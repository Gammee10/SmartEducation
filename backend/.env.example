# Backend environment template - copy to .env and fill in real values.
# NEVER commit the .env file.

# Database (Supabase PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?schema=public"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?schema=public"

# Auth
JWT_SECRET="change-this-to-a-long-random-secret"
JWT_EXPIRES_IN="7d"

# Cloudinary (file storage for learning materials)
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# App
NODE_ENV="development"
PORT="5000"
CLIENT_URL="http://localhost:5173"

# Number of proxy hops in front of the API (e.g. "1" for a single reverse
# proxy such as Render/Supabase hosting). Leave empty when the API is exposed
# directly. NEVER set to "true" - a client-controlled X-Forwarded-For would
# make rate limits bypassable and audit IPs forgeable.
TRUST_PROXY=""

# Initial password for users created by admins or CSV import without an
# explicit password. Required in production (the app refuses to start without
# it). NEVER ship the publicly-known example value "Password123!" - choose a
# private value and rotate it after initial rollout.
DEFAULT_USER_PASSWORD=""