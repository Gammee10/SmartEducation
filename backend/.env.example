# Backend environment template - copy to .env and fill in real values.
# NEVER commit the .env file.

# Database (Supabase PostgreSQL)
# H13: the app runs queries through the pooler (DATABASE_URL, port 6543);
# only migrations/seed use the direct connection (DIRECT_URL, port 5432).
# Size the pool as (instances x ~5) + headroom, e.g.
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?schema=public&connection_limit=10"
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?schema=public"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?schema=public"

# Auth
JWT_SECRET="change-this-to-a-long-random-secret"
JWT_EXPIRES_IN="12h"

# Cloudinary (file storage for learning materials)
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# App
NODE_ENV="development"
PORT="5000"
# M13: allowed browser origins (comma-separated for staging + prod +
# preview URLs). The legacy single-origin CLIENT_URL still works as a
# fallback. Production origins must be https:// or the API refuses to boot.
CLIENT_URLS="http://localhost:5173"
CLIENT_URL="http://localhost:5173"

# Number of proxy hops in front of the API (e.g. "1" for a single reverse
# proxy such as Render/Supabase hosting). Leave empty when the API is exposed
# directly. NEVER set to "true" - a client-controlled X-Forwarded-For would
# make rate limits bypassable and audit IPs forgeable. Deploy targets:
# Render (single proxy) -> TRUST_PROXY=1. Production refuses to boot on
# Render/Fly/Railway without this set; otherwise it logs a loud warning.
# Authenticated endpoints are additionally limited per-user, so a shared
# school NAT no longer shares one login bucket.
TRUST_PROXY=""

# Initial password for users created by admins or CSV import without an
# explicit password. Required in production (the app refuses to start without
# it). NEVER ship the publicly-known example value "Password123!" - choose a
# private value and rotate it after initial rollout.
DEFAULT_USER_PASSWORD=""

# Password assigned to the dev seed accounts (admin/teacher/student). Only
# used by `prisma:seed`; leave unset to use the dev-only default. Rotate
# seeded accounts immediately after first login in any shared environment.
SEED_PASSWORD=""