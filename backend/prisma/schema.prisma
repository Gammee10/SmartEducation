// Smart Education System - Prisma Schema (Member 1 Foundation + Library)
// Database source of truth. Managed through Prisma migrations.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------
// Enums
// ---------------------------------------------------------------

enum UserRole {
  ADMIN
  TEACHER
  STUDENT
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum LibraryBookCopyStatus {
  AVAILABLE
  BORROWED
  LOST
  DAMAGED
  ARCHIVED
}

enum LibraryBorrowRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum LibraryLoanStatus {
  ACTIVE
  RETURNED
  OVERDUE
}

// ---------------------------------------------------------------
// Identity / Foundation Models
// ---------------------------------------------------------------

model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique
  passwordHash String     @map("password_hash")
  fullName     String     @map("full_name")
  role         UserRole   @default(STUDENT)
  status       UserStatus @default(ACTIVE)
  phone        String?
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  student    Student?
  teacher    Teacher?
  auditLogs  AuditLog[]           @relation("ActorAuditLogs")
  books      LibraryBook[]        @relation("CreatedBooks")
  bookCopies LibraryBookCopy[]    @relation("CreatedCopies")
  borrowRequestsDecided LibraryBorrowRequest[] @relation("BorrowRequestDecider")
  loansIssued  LibraryLoan[]      @relation("LoanIssuedBy")
  loansReturned LibraryLoan[]     @relation("LoanReturnedBy")
  enrollments  CourseEnrollment[] @relation("EnrollmentActor")
  uploads      ContentItem[]      @relation("ContentUploader")
  assignmentsCreated Assignment[]        @relation("AssignmentCreator")
  submissionsGraded AssignmentSubmission[] @relation("SubmissionGrader")
  quizzesCreated  Quiz[]                @relation("QuizCreator")
  notifications  Notification[]   @relation("UserNotifications")
  attendanceMarked Attendance[]        @relation("AttendanceMarker")

  @@index([role, status])
  @@map("users")
}

model Student {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @unique @map("user_id") @db.Uuid
  studentCode  String   @unique @map("student_code")
  gradeLevel   String   @map("grade_level")
  section      String?
  dateOfBirth  DateTime? @map("date_of_birth")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user          User                   @relation(fields: [userId], references: [id], onDelete: Restrict)
  borrowRequests LibraryBorrowRequest[]
  loans         LibraryLoan[]
  enrollments   CourseEnrollment[]
  submissions   AssignmentSubmission[]
  quizAttempts  QuizAttempt[]
  attendances   Attendance[]

  @@index([gradeLevel])
  @@map("students")
}

model Teacher {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @unique @map("user_id") @db.Uuid
  employeeCode String  @unique @map("employee_code")
  subject     String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  courses   Course[]
  timetableSlots TimetableSlot[]

  @@map("teachers")
}

// ---------------------------------------------------------------
// LMS - Courses, Enrollment, Content
// ---------------------------------------------------------------

enum CourseStatus {
  ACTIVE
  DRAFT
  ARCHIVED
}

enum EnrollmentStatus {
  ACTIVE
  DROPPED
  COMPLETED
}

enum ContentType {
  VIDEO
  DOCUMENT
  PDF
  IMAGE
  LINK
  OTHER
}

enum AssignmentStatus {
  DRAFT
  PUBLISHED
  CLOSED
  ARCHIVED
}

enum SubmissionStatus {
  SUBMITTED
  GRADED
}

enum NotificationType {
  ASSIGNMENT
  GRADE
  QUIZ_RESULT
  ANNOUNCEMENT
  EVENT
  GENERAL
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
}

model Course {
  id            String        @id @default(uuid()) @db.Uuid
  title         String
  description   String?
  subject       String
  gradeLevel    String        @map("grade_level")
  teacherId     String        @map("teacher_id") @db.Uuid
  status        CourseStatus  @default(DRAFT)
  coverUrl      String?       @map("cover_url")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  teacher      Teacher            @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  enrollments  CourseEnrollment[]
  content      ContentItem[]
  assignments  Assignment[]
  quizzes      Quiz[]
  attendances  Attendance[]
  timetableSlots TimetableSlot[]

  @@index([teacherId, status])
  @@index([gradeLevel, status])
  @@index([status])
  @@map("courses")
}

model CourseEnrollment {
  id         String           @id @default(uuid()) @db.Uuid
  courseId   String           @map("course_id") @db.Uuid
  studentId  String           @map("student_id") @db.Uuid
  status     EnrollmentStatus @default(ACTIVE)
  enrolledById String         @map("enrolled_by_id") @db.Uuid
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")

  course      Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student     Student @relation(fields: [studentId], references: [id], onDelete: Restrict)
  enrolledBy  User    @relation("EnrollmentActor", fields: [enrolledById], references: [id], onDelete: Restrict)

  @@unique([courseId, studentId])
  @@index([studentId, status])
  @@index([courseId, status])
  @@map("course_enrollments")
}

model ContentItem {
  id          String      @id @default(uuid()) @db.Uuid
  courseId    String      @map("course_id") @db.Uuid
  title       String
  description String?
  type        ContentType @default(OTHER)
  url         String
  publicId    String?     @map("public_id")
  mimeType    String?     @map("mime_type")
  sizeBytes   Int?        @map("size_bytes")
  uploadedById String     @map("uploaded_by_id") @db.Uuid
  isArchived  Boolean     @default(false) @map("is_archived")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  course       Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  uploadedBy   User   @relation("ContentUploader", fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([courseId, isArchived])
  @@index([courseId, type])
  @@index([uploadedById])
  @@map("content_items")
}

// ---------------------------------------------------------------
// LMS - Assignments, Submissions, Grading (Member 3)
// ---------------------------------------------------------------

model Assignment {
  id           String           @id @default(uuid()) @db.Uuid
  courseId     String           @map("course_id") @db.Uuid
  title        String
  instructions String?
  maxScore     Int              @map("max_score")
  dueDate      DateTime?        @map("due_date")
  status       AssignmentStatus @default(DRAFT)
  createdById  String           @map("created_by_id") @db.Uuid
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  course       Course                 @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdBy    User                   @relation("AssignmentCreator", fields: [createdById], references: [id], onDelete: Restrict)
  submissions  AssignmentSubmission[]

  @@index([courseId, status])
  @@index([courseId, dueDate])
  @@index([status, dueDate])
  @@index([createdById])
  @@map("assignments")
}

model AssignmentSubmission {
  id           String           @id @default(uuid()) @db.Uuid
  assignmentId String           @map("assignment_id") @db.Uuid
  studentId    String           @map("student_id") @db.Uuid
  content      String?
  fileUrl      String?          @map("file_url")
  publicId     String?          @map("public_id")
  mimeType     String?          @map("mime_type")
  sizeBytes    Int?             @map("size_bytes")
  status       SubmissionStatus @default(SUBMITTED)
  isLate       Boolean          @default(false) @map("is_late")
  score        Float?
  feedback     String?
  gradedById   String?          @map("graded_by_id") @db.Uuid
  gradedAt     DateTime?        @map("graded_at")
  submittedAt  DateTime         @default(now()) @map("submitted_at")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student    Student    @relation(fields: [studentId], references: [id], onDelete: Restrict)
  gradedBy   User?      @relation("SubmissionGrader", fields: [gradedById], references: [id], onDelete: SetNull)

  @@unique([assignmentId, studentId])
  @@index([assignmentId, status])
  @@index([studentId, status])
  @@index([status, submittedAt])
  @@map("assignment_submissions")
}

// ---------------------------------------------------------------
// Quizzes - Quiz, Questions, Options, Attempts, Answers (Member 4)
// ---------------------------------------------------------------

enum QuizStatus {
  DRAFT
  PUBLISHED
  CLOSED
  ARCHIVED
}

enum QuizQuestionType {
  MULTIPLE_CHOICE
  SINGLE_CHOICE
}

enum QuizAttemptStatus {
  IN_PROGRESS
  SUBMITTED
  TIME_EXPIRED
}

model Quiz {
  id          String     @id @default(uuid()) @db.Uuid
  courseId    String     @map("course_id") @db.Uuid
  title       String
  description String?
  timeLimit   Int        @map("time_limit") // minutes
  maxAttempts Int        @map("max_attempts") @default(1)
  shuffleQuestions Boolean @default(false) @map("shuffle_questions")
  shuffleOptions  Boolean @default(false) @map("shuffle_options")
  status      QuizStatus @default(DRAFT)
  publishedAt DateTime?  @map("published_at")
  createdById String     @map("created_by_id") @db.Uuid
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  course    Course                 @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdBy User                   @relation("QuizCreator", fields: [createdById], references: [id], onDelete: Restrict)
  questions QuizQuestion[]
  attempts  QuizAttempt[]

  @@index([courseId, status])
  @@index([courseId, createdAt])
  @@index([status, publishedAt])
  @@index([createdById])
  @@map("quizzes")
}

model QuizQuestion {
  id          String           @id @default(uuid()) @db.Uuid
  quizId      String           @map("quiz_id") @db.Uuid
  prompt      String
  type        QuizQuestionType @default(SINGLE_CHOICE)
  points      Int              @default(1)
  orderIndex  Int              @default(0) @map("order_index")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  quiz     Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  options  QuizOption[]
  answers  QuizAnswer[]

  @@index([quizId, orderIndex])
  @@map("quiz_questions")
}

model QuizOption {
  id         String   @id @default(uuid()) @db.Uuid
  questionId String   @map("question_id") @db.Uuid
  optionText String   @map("option_text")
  isCorrect  Boolean  @default(false) @map("is_correct")
  orderIndex Int      @default(0) @map("order_index")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  question QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answers  QuizAnswer[]

  @@index([questionId])
  @@map("quiz_options")
}

model QuizAttempt {
  id          String            @id @default(uuid()) @db.Uuid
  quizId      String            @map("quiz_id") @db.Uuid
  studentId   String            @map("student_id") @db.Uuid
  status      QuizAttemptStatus @default(IN_PROGRESS)
  startedAt   DateTime          @default(now()) @map("started_at")
  submittedAt DateTime?         @map("submitted_at")
  expiresAt   DateTime          @map("expires_at")
  score       Float?
  maxScore    Int?
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  quiz     Quiz          @relation(fields: [quizId], references: [id], onDelete: Cascade)
  student  Student       @relation(fields: [studentId], references: [id], onDelete: Restrict)
  answers  QuizAnswer[]

  @@index([quizId, studentId])
  @@index([studentId, status])
  @@index([quizId, status])
  @@index([status, startedAt])
  @@map("quiz_attempts")
}

model QuizAnswer {
  id         String   @id @default(uuid()) @db.Uuid
  attemptId  String   @map("attempt_id") @db.Uuid
  questionId String   @map("question_id") @db.Uuid
  optionId   String?  @map("option_id") @db.Uuid
  isCorrect  Boolean?
  pointsEarned Float? @map("points_earned")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  attempt   QuizAttempt   @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question  QuizQuestion  @relation(fields: [questionId], references: [id], onDelete: Restrict)
  option    QuizOption?   @relation(fields: [optionId], references: [id], onDelete: SetNull)

  @@unique([attemptId, questionId])
  @@index([questionId])
  @@map("quiz_answers")
}

// ---------------------------------------------------------------
// Notifications - in-app notification contract (Member 6 extends)
// ---------------------------------------------------------------

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  title     String
  message   String
  type      NotificationType @default(GENERAL)
  isRead    Boolean          @default(false) @map("is_read")
  metadata  Json?
  createdAt DateTime         @default(now()) @map("created_at")

  user User @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([type, createdAt])
  @@map("notifications")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  actorId   String?  @map("actor_id") @db.Uuid
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  metadata  Json?
  ipAddress String?  @map("ip_address")
  createdAt DateTime @default(now()) @map("created_at")

  actor User? @relation("ActorAuditLogs", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([entity, entityId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------------
// SIS - Attendance & Timetable (Member 5)
// ---------------------------------------------------------------

model Attendance {
  id         String           @id @default(uuid()) @db.Uuid
  studentId  String           @map("student_id") @db.Uuid
  courseId   String           @map("course_id") @db.Uuid
  date       DateTime         @map("date") @db.Date
  status     AttendanceStatus @default(PRESENT)
  markedById String           @map("marked_by_id") @db.Uuid
  markedAt   DateTime         @default(now()) @map("marked_at")
  comment    String?
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")

  student   Student @relation(fields: [studentId], references: [id], onDelete: Restrict)
  course    Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  markedBy  User    @relation("AttendanceMarker", fields: [markedById], references: [id], onDelete: Restrict)

  @@unique([studentId, courseId, date])
  @@index([studentId, date])
  @@index([courseId, date])
  @@map("attendances")
}

model TimetableSlot {
  id        String     @id @default(uuid()) @db.Uuid
  courseId  String     @map("course_id") @db.Uuid
  teacherId String?    @map("teacher_id") @db.Uuid
  dayOfWeek DayOfWeek  @map("day_of_week")
  startTime String     @map("start_time") // '08:00'
  endTime   String     @map("end_time")   // '09:30'
  room      String?
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  teacher Teacher? @relation(fields: [teacherId], references: [id], onDelete: SetNull)

  @@index([teacherId, dayOfWeek])
  @@index([courseId, dayOfWeek])
  @@map("timetable_slots")
}

// ---------------------------------------------------------------
// Library Models
// ---------------------------------------------------------------

model LibraryBook {
  id            String   @id @default(uuid()) @db.Uuid
  title         String
  author        String
  isbn          String?  @unique
  publisher     String?
  publishedYear Int?     @map("published_year")
  category      String?
  description   String?
  coverUrl      String?  @map("cover_url")
  createdById   String   @map("created_by_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  createdBy User              @relation("CreatedBooks", fields: [createdById], references: [id], onDelete: Restrict)
  copies    LibraryBookCopy[]

  @@index([title])
  @@index([author])
  @@index([isbn])
  @@map("library_books")
}

model LibraryBookCopy {
  id         String                @id @default(uuid()) @db.Uuid
  bookId     String                @map("book_id") @db.Uuid
  copyNumber String                @map("copy_number")
  status     LibraryBookCopyStatus @default(AVAILABLE)
  condition  String?
  location   String?
  createdById String               @map("created_by_id") @db.Uuid
  createdAt  DateTime              @default(now()) @map("created_at")
  updatedAt  DateTime              @updatedAt @map("updated_at")

  book           LibraryBook           @relation(fields: [bookId], references: [id], onDelete: Cascade)
  createdBy      User                  @relation("CreatedCopies", fields: [createdById], references: [id], onDelete: Restrict)
  loans          LibraryLoan[]
  borrowRequests LibraryBorrowRequest[]

  @@unique([bookId, copyNumber])
  @@index([status])
  @@map("library_book_copies")
}

model LibraryBorrowRequest {
  id          String                       @id @default(uuid()) @db.Uuid
  studentId   String                       @map("student_id") @db.Uuid
  bookCopyId  String                       @map("book_copy_id") @db.Uuid
  status      LibraryBorrowRequestStatus   @default(PENDING)
  requestedAt DateTime                     @default(now()) @map("requested_at")
  decidedById String?                      @map("decided_by_id") @db.Uuid
  decidedAt   DateTime?                    @map("decided_at")
  reason      String?
  createdAt   DateTime                     @default(now()) @map("created_at")
  updatedAt   DateTime                     @updatedAt @map("updated_at")

  student   Student              @relation(fields: [studentId], references: [id], onDelete: Restrict)
  bookCopy  LibraryBookCopy      @relation(fields: [bookCopyId], references: [id], onDelete: Restrict)
  decidedBy User?                @relation("BorrowRequestDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  loan      LibraryLoan?

  @@unique([studentId, bookCopyId, status])
  @@index([studentId, status])
  @@index([bookCopyId, status])
  @@index([status, requestedAt])
  @@map("library_borrow_requests")
}

model LibraryLoan {
  id          String             @id @default(uuid()) @db.Uuid
  borrowReqId String             @unique @map("borrow_request_id") @db.Uuid
  studentId   String             @map("student_id") @db.Uuid
  bookCopyId  String             @map("book_copy_id") @db.Uuid
  status      LibraryLoanStatus  @default(ACTIVE)
  issuedById  String             @map("issued_by_id") @db.Uuid
  issuedAt    DateTime           @default(now()) @map("issued_at")
  dueDate     DateTime           @map("due_date")
  returnedAt  DateTime?          @map("returned_at")
  returnedById String?           @map("returned_by_id") @db.Uuid
  notes       String?
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  borrowRequest LibraryBorrowRequest @relation(fields: [borrowReqId], references: [id], onDelete: Restrict)
  student       Student              @relation(fields: [studentId], references: [id], onDelete: Restrict)
  bookCopy      LibraryBookCopy      @relation(fields: [bookCopyId], references: [id], onDelete: Restrict)
  issuedBy      User                 @relation("LoanIssuedBy", fields: [issuedById], references: [id], onDelete: Restrict)
  returnedBy    User?                @relation("LoanReturnedBy", fields: [returnedById], references: [id], onDelete: SetNull)

  @@index([studentId, status])
  @@index([bookCopyId, status])
  @@index([status, dueDate])
  @@map("library_loans")
}